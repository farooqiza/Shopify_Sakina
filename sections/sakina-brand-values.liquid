<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<section
  class="sakina-values section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  aria-label="{{ section.settings.heading | escape }}"
>
  {%- if section.settings.heading != blank -%}
    <p class="sakina-values__heading-label">{{ section.settings.heading | escape }}</p>
  {%- endif -%}

  <div class="sakina-values__inner" style="--value-cols: {{ section.blocks.size | at_most: 4 }};">
    {%- for block in section.blocks -%}
      <div class="sakina-value-item" {{ block.shopify_attributes }}>
        <div class="sakina-value-item__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'quality' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            {%- when 'shipping' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
            {%- when 'returns' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"></polyline><path d="M3.51 15a9 9 0 1 0 .49-3.51"></path></svg>
            {%- when 'secure' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            {%- when 'handcrafted' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            {%- when 'sustainability' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            {%- when 'support' -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          {%- endcase -%}
        </div>
        <h3 class="sakina-value-item__heading">{{ block.settings.heading | escape }}</h3>
        {%- if block.settings.text != blank -%}
          <p class="sakina-value-item__text">{{ block.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .sakina-values__heading-label {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.4;
    margin-bottom: 32px;
    text-align: center;
  }

  .sakina-values__inner {
    grid-template-columns: repeat(var(--value-cols, 4), 1fr);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Values",
  "tag": "div",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section label",
      "default": "The Sakina Promise"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "page-width", "label": "Page width" },
        { "value": "full-width", "label": "Full width" }
      ],
      "default": "page-width"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "quality",        "label": "Quality / Award" },
            { "value": "shipping",       "label": "Shipping / Delivery" },
            { "value": "returns",        "label": "Returns" },
            { "value": "secure",        "label": "Secure / Shield" },
            { "value": "handcrafted",   "label": "Handcrafted / Heart" },
            { "value": "sustainability","label": "Sustainability" },
            { "value": "support",       "label": "Support / Chat" }
          ],
          "default": "quality"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Premium Quality"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Every piece is carefully selected and quality-checked before it reaches your home."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Values",
      "settings": {
        "heading": "The Sakina Promise",
        "color_scheme": "scheme-1",
        "section_width": "page-width"
      },
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "handcrafted",
            "heading": "Artisan Craftsmanship",
            "text": "Each piece is hand-selected from master artisans who have refined their craft over generations."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "shipping",
            "heading": "Free Shipping",
            "text": "Complimentary delivery on all orders over £150, with white-glove handling for fragile pieces."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "returns",
            "heading": "30-Day Returns",
            "text": "Not in love with your purchase? We offer hassle-free returns within 30 days, no questions asked."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "support",
            "heading": "Expert Guidance",
            "text": "Our interior lighting specialists are here to help you find the perfect piece for your space."
          }
        }
      ]
    }
  ]
}
{% endschema %}
