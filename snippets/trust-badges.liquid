<div class="trust-badges" aria-label="Trust signals">
  <div class="trust-badges__item">
    <span class="trust-badges__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
    </span>
    <span class="trust-badges__text">Secure Checkout</span>
  </div>
  <div class="trust-badges__divider" aria-hidden="true"></div>
  <div class="trust-badges__item">
    <span class="trust-badges__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
    </span>
    <span class="trust-badges__text">Free Returns</span>
  </div>
  <div class="trust-badges__divider" aria-hidden="true"></div>
  <div class="trust-badges__item">
    <span class="trust-badges__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
    </span>
    <span class="trust-badges__text">Free Shipping Over $150</span>
  </div>
  <div class="trust-badges__divider" aria-hidden="true"></div>
  <div class="trust-badges__item">
    <span class="trust-badges__icon" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12.6 19.79 19.79 0 0 1 1.61 4a2 2 0 0 1 1.94-2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.13 6.13l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
    </span>
    <span class="trust-badges__text">Expert Support</span>
  </div>
</div>

{% stylesheet %}
  .trust-badges {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    padding: 14px 0;
    border-top: 1px solid rgb(var(--color-border-rgb) / 0.6);
    border-bottom: 1px solid rgb(var(--color-border-rgb) / 0.6);
    margin-block: 16px;
  }

  .trust-badges__item {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    color: rgb(var(--color-foreground-rgb) / 0.75);
  }

  .trust-badges__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .trust-badges__text {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    line-height: 1;
  }

  .trust-badges__divider {
    width: 1px;
    height: 20px;
    background: rgb(var(--color-border-rgb) / 0.5);
    flex-shrink: 0;
  }

  @media screen and (max-width: 480px) {
    .trust-badges {
      gap: 8px 0;
    }

    .trust-badges__divider:nth-child(4) {
      display: none;
    }

    .trust-badges__item {
      padding: 2px 8px;
    }

    .trust-badges__text {
      font-size: 10px;
    }
  }
{% endstylesheet %}
